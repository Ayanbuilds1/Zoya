# Zoya Stage 2 image provider configuration
# Keep real secrets only in your local .env. Never commit them.

IMAGE_PROVIDER_ORDER=freellmapi,pollinations,nvidia,local_sd
IMAGE_PROVIDER_COOLDOWN_SECONDS=30

# Self-hosted FreeLLMAPI
FREELLMAPI_BASE_URL=http://localhost:3001/v1
FREELLMAPI_API_KEY=
FREELLMAPI_IMAGE_MODEL=auto

# Pollinations
POLLINATIONS_BASE_URL=https://gen.pollinations.ai
POLLINATIONS_API_KEY=
POLLINATIONS_IMAGE_MODEL=black-forest-labs/flux.1-schnell

# NVIDIA hosted Visual GenAI
NVIDIA_IMAGE_BASE_URL=https://ai.api.nvidia.com/v1/genai
NVIDIA_API_KEY=
NVIDIA_IMAGE_MODEL=black-forest-labs/flux.2-klein-4b

# Local stable-diffusion.cpp emergency fallback
LOCAL_SD_BINARY=
LOCAL_SD_MODEL=
LOCAL_SD_MODEL_ARGUMENT=-m
LOCAL_SD_STEPS=8
